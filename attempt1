Qualtrics.SurveyEngine.addOnload(function () {
    const pointsContainer = document.getElementById('pointsContainer');
    const pointsText = document.getElementById('pointsText');
    const showPoints = Qualtrics.SurveyEngine.getJSEmbeddedData("arePointsVisible") === "true";

    if (showPoints && pointsText) {
        pointsText.innerText = "You currently have " + 
            parseInt(Qualtrics.SurveyEngine.getJSEmbeddedData("SurveyPoints")) + " points!";
    } else if (pointsContainer) {
        pointsContainer.style.display = 'none';
    }

    if (typeof updatePointsDisplay === "function") {
        updatePointsDisplay();
    }
});
