Qualtrics.SurveyEngine.addOnload(function () {
    if (typeof updatePointsDisplay === "function") {
        updatePointsDisplay();
    }
});

Qualtrics.SurveyEngine.addOnReady(function () {
    const awardFlagName = "Q_letsEarnSomePoints"; //This is the unique embedded question name to prevent back-button point farming
    const addAmount = parseInt(Qualtrics.SurveyEngine.getJSEmbeddedData("MultipleChoicePoints")) || 0;
    let pointsGained = false; 

    this.questionclick = function (event, element) {
        if (element.type === 'radio' && !pointsGained) {
            const hasAwarded = Qualtrics.SurveyEngine.getJSEmbeddedData(awardFlagName);

            if (hasAwarded !== "true") {
                const currentScore = parseInt(Qualtrics.SurveyEngine.getJSEmbeddedData("SurveyPoints")) || 0;
                const currentInteractions = parseInt(Qualtrics.SurveyEngine.getJSEmbeddedData("InteractionScore")) || 0;
                const newScore = currentScore + addAmount;
                const newInteractions = currentInteractions + 1;

                Qualtrics.SurveyEngine.setJSEmbeddedData("SurveyPoints", newScore);
                Qualtrics.SurveyEngine.setJSEmbeddedData("InteractionScore", newInteractions);
                Qualtrics.SurveyEngine.setJSEmbeddedData(awardFlagName, "true");

                if (typeof updatePointsDisplay === "function") updatePointsDisplay();
                if (typeof showPlusPoints === "function") showPlusPoints(addAmount);
                

                pointsGained = true; 
            }
        }
    };
});

