		document.getElementById('pointsText').innerText = "You currently have " + parseInt(Qualtrics.SurveyEngine.getJSEmbeddedData("SurveyPoints")) + " points!";
	} else {
		document.getElementById('pointsContainer').style.display = 'none';
	}

});

